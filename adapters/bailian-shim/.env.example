# ============================================================
#  百炼转换层配置
#  复制成 .env 后填写，并执行 chmod 600 .env
# ============================================================

# ---------- 必填 ----------

# 百炼 API-KEY（百炼控制台 → API-KEY 管理）
DASHSCOPE_API_KEY=sk-在这里填你的百炼APIKEY

# ★ 多个百炼应用的路由表（推荐）
#   格式： 模型名=app_id,模型名=app_id
#   请求体里的 "model" 字段决定用哪个应用（demo-partner 的 config.toml 里配 model）
#   例：
#     BAILIAN_APPS=ros2_codegen=your-bailian-app-id,ros2_plan=xxxx,ros2_analyze=yyyy
BAILIAN_APPS=

# 单个应用的写法（向后兼容；只有在 BAILIAN_APPS 为空时才生效）
# BAILIAN_APP_ID=your-bailian-app-id

# ---------- 通常需要确认 ----------

# 工作流的入参字段名。
# 默认 prompt；如果你在工作流的「开始」节点里把入参变量命名成了别的
# （比如 query、question、input），这里要改成一样的，否则百炼会报参数错误。
BAILIAN_INPUT_FIELD=prompt

# ---------- biz_params（工作流「开始节点」的自定义变量）----------
# 有些工作流的入参不只有 sys.query，还要走 biz_params 传结构化变量
# （例如 requirement_json / node_spec_json / leader_context / history）。
#
# 调用方把结构化参数放进 prompt 里的标记块，shim 解析出来转成 biz_params，
# 并从发给工作流的 prompt 里删掉：
#
#     <自然语言需求>
#
#     <<<BIZ_PARAMS>>>
#     {"requirement_json": "{\"project\": ...}"}
#     <<<END_BIZ_PARAMS>>>
#
BIZ_BEGIN_MARKER=<<<BIZ_PARAMS>>>
BIZ_END_MARKER=<<<END_BIZ_PARAMS>>>

# prompt 整体就是一个 JSON 对象时，是否直接当作 biz_params（1 = 是）
BIZ_AUTO_JSON=0

# 百炼的流式开关。机器要拿完整 JSON，所以用 none
FLOW_STREAM_MODE=none

# ---------- 可选 ----------

# 百炼接口地址（国内站默认值，一般不用改）
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com

# 业务空间 ID（如果你把应用建在非默认业务空间，填上；否则留空）
# BAILIAN_WORKSPACE=llm-xxxxxxxxxxxxxxxx

# 上游超时（秒）
BAILIAN_TIMEOUT=120

# 发给百炼的 prompt 怎么拼：
#   last_user = 只取最后一条 user 消息（默认，推荐）
#   all       = 把整段对话拼成一段文本
MESSAGE_MODE=last_user

# 多轮会话：1 = 把 OpenAI 的 user 字段当作百炼 session_id 传给工作流
USE_SESSION=0

# ---------- 本层自身 ----------

# 本层自己的鉴权 key（demo-partner 会用这个当 api_key）
SHIM_API_KEY=sk-local-shim

# 对外暴露的模型名（随便起，demo-partner 里 model 字段要跟它一致）
MODEL_NAME=bailian-workflow

# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO
