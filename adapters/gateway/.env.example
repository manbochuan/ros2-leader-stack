# ============================================================
#  ACPs 出站网关配置
#  复制成 .env 后按需修改
# ============================================================

# 监听
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9100

# 对外基础地址（会写进 OpenAPI 的 servers 字段，百炼靠它拼完整 URL）
PUBLIC_BASE_URL=http://YOUR_HOST:9100

# ★ 百炼调用时必须在请求头里带这个值： X-Auth-Token: <下面的值>
#   请改成一串长的随机字符（不要留默认值）
AUTH_TOKEN=change-me-to-a-long-random-string

# 我们自己的 AIC（出站调用时报文里的 senderId，必须与客户端证书主体名一致）
MY_AIC=1.2.156.3088.1.BUPT.AAAAAA.BBBBBB.CCCC.DDDD

# 客户端证书与私钥（出站调用用；这一对绝不允许离开服务器）
CLIENT_CERT=/opt/acps-agent/acps-community/acps-cli/private/agent-cert.pem
CLIENT_KEY=/opt/acps-agent/acps-community/acps-cli/private/agent-key.pem
# 用来验证对方服务端证书（平台 CA 的信任包）
CA_BUNDLE=/opt/acps-agent/acps-community/acps-cli/private/trust-bundle.pem

# 对端服务器证书的校验强度：
#   chain  = 验证证书链，但不校验主机名/IP   ← 默认
#   strict = 证书链 + 主机名/IP 全校验
#   off    = 完全不校验（仅本地调试）
# 为什么默认 chain：平台上不少智能体的 ACS 没声明 certificate.altNames.ip，
# 证书 SAN 里没有自己的公网 IP，严格校验会直接拒连。
VERIFY_SERVER_CERT=chain

# /ask_platform 里，一个搭档调失败后最多再试几个（按平台给出的相关度顺序）
# 语义检索的第一名不一定最合适，失败回退能明显提升成功率。
# 设 1 = 不回退（只试第一个）
ASK_PLATFORM_MAX_TRIES=2

# 调平台外部搭档的超时（比自己家的短 —— 外部通常 1~20 秒出结果）
ASK_PLATFORM_TIMEOUT_SEC=60

# 对方回了 accepted 却一直不开始处理的容忍秒数。
# 实测遇到过：对方 accept 后就再没动静，原本要白等到超时。
# 超过这个时间仍停在 accepted → 判定对方异常，提前去试下一个。
ACCEPTED_STALL_SEC=20

# AIP 调用参数（调自己家的 /wf/* 用这个）
DEFAULT_TIMEOUT_SEC=180
POLL_INTERVAL_SEC=2.0

# 搭档映射表
TARGETS_FILE=/opt/acps-agent/acps-gateway/targets.json

# acps-cli（/discover 接口用来自动发现平台上的智能体）
ACPS_CLI_DIR=/opt/acps-agent/acps-community/acps-cli
ACPS_CLI_BIN=/opt/acps-agent/acps-community/acps-cli/.venv/bin/acps-cli
ACPS_CLI_CONFIG=acps-cli.toml

LOG_LEVEL=INFO
