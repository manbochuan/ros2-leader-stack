# ============================================================
#  AMP 日志转发器配置
#  复制成 .env 后按需修改
# ============================================================

# 智能体写日志的目录（demo-partner 的 logs/）
AMP_LOG_DIR=/opt/acps-agent/acps-community/demo-partner/logs

# 平台 Kafka 地址（多个用逗号分隔）
KAFKA_BROKERS=wt.ioa.pub:19092

# 安全协议： PLAINTEXT / SSL / SASL_SSL
# 先用默认值跑，如果连不上就用 --probe 自动探测
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# 下面是 SSL 时才需要的（自签证书时把校验关掉）
# KAFKA_SSL_CAFILE=/etc/ssl/certs/ca-certificates.crt
# KAFKA_SSL_CHECK_HOSTNAME=0

# 读取位置： tail = 只转发新产生的日志（推荐）
#           head = 从头补发全部历史（首次上线时会一次发很多）
START_FROM=tail

# 扫描间隔（秒）
POLL_INTERVAL=1.0

# 进度报告的间隔（秒）
REPORT_INTERVAL=20

# 日志级别
LOG_LEVEL=INFO
