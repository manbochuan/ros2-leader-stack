# ============================================================================
#  平台对外身份接入层（:8449）的环境变量
#  由 install.sh 生成 .env；本文件是模板，不要放真实密钥
#
#  ★ 与 ①②③ 最大的区别：default 档指向【Leader :9200】，不是 shim
# ============================================================================

# ---- fast 档：接入层"决策 + 分析"两段（只做判断和复制）----
PARTNER_LLM_FAST_API_KEY=sk-your-dashscope-key
PARTNER_LLM_FAST_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PARTNER_LLM_FAST_MODEL=qwen-flash

# ---- default 档：production 阶段 → 本机 Leader ----
PARTNER_LLM_DEFAULT_BASE_URL=http://127.0.0.1:9200/v1
PARTNER_LLM_DEFAULT_MODEL=leader
# ★ 必须和 Leader 的 .env 里 AUTH_TOKEN 一致（Leader 也接受 Authorization: Bearer）
PARTNER_LLM_DEFAULT_API_KEY=change-me

# ---- 证书目录（install.sh 会把 server.pem / server.key / trust-bundle.pem 拷到本目录）----
CERT_DIR=/opt/ros2-leader-stack/certs/leader_orchestrator
