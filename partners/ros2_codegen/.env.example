# ============================================================================
#  ③ 代码生成接入层（:9023）的环境变量
#  由 install.sh 生成 .env；本文件是模板，不要放真实密钥
# ============================================================================

# ---- fast 档：接入层自己"决策 + 分析"两段用（要快）----
PARTNER_LLM_FAST_API_KEY=sk-your-dashscope-key
PARTNER_LLM_FAST_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PARTNER_LLM_FAST_MODEL=qwen-flash

# ---- default 档：production 阶段 → 本机 shim → 百炼工作流 ③ ----
PARTNER_LLM_DEFAULT_API_KEY=sk-your-dashscope-key
PARTNER_LLM_DEFAULT_BASE_URL=http://127.0.0.1:9099/v1
# ★ 这个名字要和 shim 的路由对上
PARTNER_LLM_DEFAULT_MODEL=code_gen

# ---- 证书目录（install.sh 会把 server.pem / server.key / trust-bundle.pem 拷到本目录）----
CERT_DIR=/opt/ros2-leader-stack/certs/ros2_codegen
