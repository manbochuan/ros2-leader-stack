# ============================================================
#  Leader 编排服务配置
#  复制成 .env 后填写，并执行 chmod 600 .env
# ============================================================

# ---------- 监听 ----------
LEADER_HOST=0.0.0.0
LEADER_PORT=9200

# 鉴权头：百炼插件里配 X-Auth-Token
AUTH_TOKEN=换成随机串

# ---------- 百炼 ----------
DASHSCOPE_API_KEY=sk-在这里填百炼APIKEY
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---------- 三个 Partner 的 AIC（★ 走平台，定死用我们自己的）----------
#
# 这三个 Partner 注册到梧桐平台之后，把它们的 AIC 填在这里。
# 填了 → Leader 走「网关 → 平台」调用，并带 only_aic 把目标锁死；
# 留空 → Leader 退回「直连百炼」，用下面的 appId（过渡期用）。
#
# 为什么要锁死 AIC：
#   平台语义检索可能挑到别人家同名的「需求分析/项目规划」搭档，
#   那些搭档的输出格式和我们的下游对不上 —— 而且"成功但格式不对"
#   不会触发网关的失败回退，很难排查。
REQUIREMENT_AIC=
PLAN_AIC=
CODEGEN_AIC=

# 检索这三个 Partner 时用的关键词（一般不用改）
NEED_REQUIREMENT=ROS2 需求分析
NEED_PLAN=ROS2 项目规划
NEED_CODEGEN=ROS2 单节点代码生成

# ---------- 三个 Partner 的百炼 appId（★ 只作为"没配 AIC 时的降级方案"）----------
PARTNER1_APP=your-bailian-app-id     # ① 需求分析
PARTNER2_APP=your-bailian-app-id     # ② 项目规划
PARTNER3_APP=your-bailian-app-id     # ③ 代码生成

# ---------- Partner 传参形态（仅"直连百炼"模式用）----------
# 百炼「工作流应用」的开始节点自定义变量怎么通过 API 传进去，实测没通。
# 建议改成「让工作流从 sys.query 读 JSON」，就完全不需要这个了。
#
#   input.biz_params        biz_params 放在 input 里（官方文档写法）← 默认
#   top.biz_params          biz_params 放在顶层
#   input.flat              变量直接放 input 里
#   input.biz_params.udp    再包一层 user_defined_params
BIZ_MODE=input.biz_params

# 百炼的流式模式。官方合法值只有三个：
#   message_format（推荐） / full_thoughts（默认） / agent_format
# 留空 = 不传这个参数（用百炼默认值）
FLOW_STREAM_MODE=

# 单个 Partner 的超时与重试（走平台时我们自己的智能体要 80~120 秒）
PARTNER_TIMEOUT_SEC=300
PARTNER_RETRY=1

# ---------- 编排参数 ----------
# 代码生成并发上限（同学文档 CC-05：上限 4）
MAX_CONCURRENCY=4

# 分批策略：节点数 >= BATCH_THRESHOLD 时，先出 BATCH_FIRST 个
BATCH_THRESHOLD=3
BATCH_FIRST=2

# 会话记忆窗口（同学文档 L-02：15 轮）
HISTORY_TURNS=15

# ---------- 知识库（报错排查用）----------
# 同学文档第七节给的接口
KB_URL=http://YOUR_HOST:8000/search
KB_TOP_K=5
KB_TIMEOUT_SEC=20

# ---------- 出站网关（调叮当的搭档）----------
# Leader 判断"不是 ROS2 领域"的需求，转给网关的 /ask_platform，
# 由网关去做：平台检索 → 选最匹配的 → mTLS+AIP 调用。
# GATEWAY_TOKEN 要和 acps-gateway/.env 里的 AUTH_TOKEN 一致。
GATEWAY_URL=http://127.0.0.1:9100
GATEWAY_TOKEN=change-me-gateway-token
GATEWAY_TIMEOUT_SEC=180

# ---------- 小模型（意图兜底 / 概念问答 / 报错排查）----------
ANSWER_MODEL=qwen-flash
ANSWER_MAX_TOKENS=1500
ROUTER_MODEL=qwen-flash

# ---------- 其它 ----------
LEADER_DB=/opt/acps-agent/leader/leader.db
LOG_LEVEL=INFO
